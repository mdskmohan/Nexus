# Copy to .env and fill in. Never commit .env.

# Required for the AI features. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Session signing secret. Generate one with: openssl rand -hex 32
NEXUS_JWT_SECRET=

# Optional overrides (defaults shown)
# NEXUS_MODEL=claude-opus-5
# NEXUS_EFFORT=high
# NEXUS_AGENT_BUDGET_USD=5.00
# NEXUS_DATABASE_URL=postgresql+psycopg://nexus_app:nexus_app_dev@localhost:5544/nexus
# NEXUS_DATABASE_OWNER_URL=postgresql+psycopg://nexus_owner:nexus_owner_dev@localhost:5544/nexus
