# Copy to .env and fill in. Never commit .env.

# Optional platform-wide Claude key, used only by firms that have not added their own
# AI models in Firm settings (and by the benchmark runner). Leave empty for bring-your-own-key.
ANTHROPIC_API_KEY=

# Session signing secret. Generate one with: openssl rand -hex 32
NEXUS_JWT_SECRET=

# Encrypts firms' AI provider keys stored in the database. Generate: openssl rand -base64 32
NEXUS_SECRET_KEY=

# Optional overrides (defaults shown)
# NEXUS_MODEL=claude-opus-5
# NEXUS_EFFORT=high
# NEXUS_AGENT_BUDGET_USD=5.00
# NEXUS_DATABASE_URL=postgresql+psycopg://nexus_app:nexus_app_dev@localhost:5544/nexus
# NEXUS_DATABASE_OWNER_URL=postgresql+psycopg://nexus_owner:nexus_owner_dev@localhost:5544/nexus
